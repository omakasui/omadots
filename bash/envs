# Editor used by CLI
export EDITOR="nvim"
export SUDO_EDITOR="$EDITOR"

# Fix BAT theme
export BAT_THEME=ansi

# Color man pages with bat
export MANROFFOPT="-c"
export MANPAGER="sh -c 'col -bx | batcat -l man -p'"

# GPG TTY per pinentry
export GPG_TTY=$(tty)

# Dotfiles
export DOTFILES_PATH=$HOME/.cfg
export PATH=$DOTFILES_PATH/bin:$PATH