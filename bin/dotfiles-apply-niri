#! /bin/bash

# dotfiles:summary=Apply dotfiles niri (+ DMS) configuration

source "$DOTFILES_PATH/lib/output"

apply_dotfiles_niri() {
    if [[ ! -d "$HOME/.config/niri" ]]; then
        mkdir -p "$HOME/.config/niri"
    fi
    cp -R $DOTFILES_PATH/config/niri/dms/* $HOME/.config/niri
}

apply_dotfiles_niri
echo -e "${GREEN}Dotfiles niri configuration applied to $HOME/.config/niri.${RESET}"
