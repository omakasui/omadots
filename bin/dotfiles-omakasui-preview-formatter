#!/bin/bash
# dotfiles:summary=Format all preview images in omakasui themes
# dotfiles:args=<path to omakasui themes directory (f.e. ~/.local/share/omakub/themes)>
# dotfiles:group=omakasui

if [[ $# -ne 1 ]]; then
  echo "Usage: $0 <path to omakasui themes directory>"
  exit 1
fi

THEMES_DIR="$1"
IMAGE_TYPES=("preview.png" "preview-unlock.png")

for dir in "$THEMES_DIR"/*/; do
    if [ -d "$dir" ]; then
        for img_type in "${IMAGE_TYPES[@]}"; do
            if [ -f "${dir}${img_type}" ]; then
                echo "Processing: ${dir}${img_type}"
                convert "${dir}${img_type}" -resize 1800x -strip -interlace Plane -quality 85 "${dir}${img_type%.*}.png"
            else
                echo "Skipped (no ${img_type}): $dir"
            fi
        done
    fi
done