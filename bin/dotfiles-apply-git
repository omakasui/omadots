#! /bin/bash

# dotfiles:summary=Apply dotfiles git configuration

source "$DOTFILES_PATH/lib/output"

apply_dotfiles_git() {
    if [[ ! -d "$HOME/.config/git" ]]; then
        mkdir -p "$HOME/.config/git"
    fi
    cp -R $DOTFILES_PATH/config/git/* $HOME/.config/git
}

apply_dotfiles_git
echo -e "${GREEN}Dotfiles git configuration applied to $HOME/.config/git.${RESET}"