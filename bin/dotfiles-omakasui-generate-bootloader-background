#!/bin/bash
# dotfiles:summary=Generate themed bootloader backgrounds for all themes (using unlock.png as logo)
# dotfiles:args=<path to omakasui themes directory (f.e. ~/.local/share/omakub/themes)> <optional: name of the output file (default: bootloader.png)>
# dotfiles:group=omakasui

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "Usage: $0 <path to omakasui themes directory> [output file name]"
  exit 1
fi

THEMES_DIR="$1"
OUTPUT_FILE="${2:-bootloader.png}"

for theme_dir in "$THEMES_DIR"/*/; do
  theme_name=$(basename "$theme_dir")
  colors_file="$theme_dir/colors.toml"
  unlock_png="$theme_dir/unlock.png"
  output_png="$theme_dir/$OUTPUT_FILE"

  if [[ ! -f "$colors_file" ]]; then
    echo "Skipping $theme_name: no colors.toml"
    continue
  fi

  if [[ ! -f "$unlock_png" ]]; then
    echo "Skipping $theme_name: no unlock.png"
    continue
  fi

  accent=$(grep -m1 '^accent' "$colors_file" | sed 's/.*=\s*"\(#[^"]*\)".*/\1/')
  background=$(grep -m1 '^background' "$colors_file" | sed 's/.*=\s*"\(#[^"]*\)".*/\1/')

  if [[ -z "$accent" || -z "$background" ]]; then
    echo "Skipping $theme_name: missing accent or background color"
    continue
  fi

  echo "Generating $theme_name/$OUTPUT_FILE (accent=$accent bg=$background)"

  bg_hex="${background#\#}"
  text_hex="${accent#\#}"
  logo_path="$unlock_png"
  output_path="$output_png"

  if ! [[ $bg_hex =~ ^[0-9a-fA-F]{6}$ ]]; then
    echo "Invalid background color: $1 (expected #RRGGBB)" >&2
    exit 1
  fi

  if ! [[ $text_hex =~ ^[0-9a-fA-F]{6}$ ]]; then
    echo "Invalid text color: $2 (expected #RRGGBB)" >&2
    exit 1
  fi

  if [[ ! -f $logo_path ]]; then
    echo "Logo file not found: $logo_path" >&2
    exit 1
  fi

  staging_dir=$(mktemp -d)
  trap 'rm -rf "$staging_dir"' EXIT

  cp "$logo_path" "$staging_dir/logo.png"

  canvas_w=800
  canvas_h=600

  src_logo_w=$(identify -format '%w' "$staging_dir/logo.png")
  src_logo_h=$(identify -format '%h' "$staging_dir/logo.png")

  max_logo_w=$((canvas_w / 2))
  max_logo_h=$((canvas_h / 2))

  # For pixel art, use integer scale factors to keep crisp edges.
  if (( src_logo_w <= max_logo_w && src_logo_h <= max_logo_h )); then
    # Source fits: find the largest integer upscale multiplier.
    scale=1
    while (( src_logo_w * (scale + 1) <= max_logo_w && src_logo_h * (scale + 1) <= max_logo_h )); do
      scale=$((scale + 1))
    done
    logo_w=$((src_logo_w * scale))
    logo_h=$((src_logo_h * scale))
  else
    # Source is larger than the max bounds: scale down preserving aspect ratio.
    if (( src_logo_w * max_logo_h > src_logo_h * max_logo_w )); then
      logo_w=$max_logo_w
      logo_h=$((max_logo_w * src_logo_h / src_logo_w))
    else
      logo_h=$max_logo_h
      logo_w=$((max_logo_h * src_logo_w / src_logo_h))
    fi
  fi

  margin=20
  logo_x=$margin
  logo_y=$margin

  # Scale pixel art with nearest-neighbor to keep crisp edges.
  # Pre-matte the logo with the background color before scaling so
  # any residual color in the transparent areas doesn't bleed into
  # semi-transparent edge pixels (white-halo fix).
  # Output as PNG24 (no alpha channel) for GRUB2 compatibility.
  convert -size ${canvas_w}x${canvas_h} "xc:#$bg_hex" \
    \( "$staging_dir/logo.png" -background "#$bg_hex" -alpha Background \
       -filter Point -resize ${logo_w}x${logo_h} \) \
    -geometry +${logo_x}+${logo_y} -compose Over -composite \
    -alpha off \
    "PNG24:$output_path"
done
